# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
output/

# pnpm package store; can be created repo-locally when an install runs in a
# sandbox that can't write the default user store (regenerated by pnpm install)
.pnpm-store/

# Local deploy staging (dist copy + vercel.json for CLI deploys) and the
# esbuild temp redirect used when builds run on this machine (.tmp-build)
.deploy-staging
.tmp-build

# AgentTeams plugin runtime state (staged plans, task attempts, mailboxes);
# host machine specific, regenerated by any new team
.agent-teams/

# Throwaway debug drivers + their evidence dumps (e.g. e2e/_debug-deal-repro.mjs,
# .tmp-debug/*.json screenshots/logs);host-local, deleted when a bug round ends
.tmp-debug/
e2e/_debug-*

# Git worktrees
.worktrees
dist-ssr
*.local

# Playwright
test-results
playwright-report
blob-report

# Godot board frame (godot/ — docs/plans/godot-plan.md)
# .godot/: generated import cache; .toolchain/: pinned editor/templates cache;
# godot/assets/cards/: generated PNG import staging (regenerated by pnpm godot:assets);
# public/godot/: generated export output (content-versioned, regenerated by pnpm godot:export)
.godot/
.toolchain/
godot/assets/cards/
public/godot/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ZCode workspace scope file (auto-synced from this .gitignore)
.zcodeignore
